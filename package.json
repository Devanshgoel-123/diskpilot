{
  "name": "diskpilot",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Open-source macOS storage intelligence: understand your storage, know what is safe, clean it confidently.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
