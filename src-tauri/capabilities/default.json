{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the main window. Filesystem access happens only through DiskPilot's own typed, validated Rust commands; the frontend gets no generic fs or shell plugin. Updates come only from DiskPilot's GitHub releases and are verified against its signing key. Notifications are DiskPilot's own weekly reminder, and Open at login can only be switched on or off.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart",
    "notification:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/Devanshgoel-123/diskpilot*"
        },
        {
          "url": "ms-settings:*"
        },
        {
          "url": "https://diskpilot.live/privacy"
        },
        {
          "url": "https://console.anthropic.com/settings/keys"
        },
        {
          "url": "https://platform.openai.com/api-keys"
        },
        {
          "url": "https://openrouter.ai/settings/keys"
        }
      ]
    }
  ]
}
